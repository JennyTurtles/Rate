<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.sys.rate.mapper.XinProjectMapper">

    <resultMap type="org.sys.rate.model.XinProject" id="XinProjectResult">
        <id property="id" column="id" />
        <result property="name" column="name"/>
        <result property="point" column="point"/>
        <result property="state" column="state"/>
        <result property="date" column="date"/>
        <result property="sname" column="sname"/>
        <result property="remark" column="remark"/>
        <result property="mid" column="mid"/>
        <result property="type" column="type"/>
    </resultMap>
    <!-- 插入操作 -->
    <insert id="insertXinProject" parameterType="org.sys.rate.model.XinProject">
        INSERT INTO xin_project (name, point, date, sname, state, remark, mid, type)
        VALUES (#{name}, #{point}, now(), #{sname}, #{state}, #{remark}, #{mid}, #{type});
    </insert>

    <!-- 修改操作：通过 mid 和 type 更新记录 -->
    <update id="updateXinProject" parameterType="org.sys.rate.model.XinProject">
        UPDATE xin_project
        SET
            name = #{name},
            point = #{point},
            date = now(),
            sname = #{sname},
            state = #{state},
            remark = #{remark}
        WHERE mid = #{mid} AND type = #{type};
    </update>
    <!-- 查询数据：通过 mid 和 type 更新记录 -->
    <select id="selectXinProject" parameterType="org.sys.rate.model.XinProject" resultType="org.sys.rate.model.XinProject">
        SELECT * FROM xin_project
        WHERE mid = #{mid} AND type = #{type};
    </select>

    <!-- 删除操作：通过 mid 和 type 删除记录 -->
    <delete id="deleteXinProject" parameterType="org.sys.rate.model.XinProject">
        DELETE FROM xin_project
        WHERE mid = #{mid} AND type = #{type};
    </delete>
</mapper>
