    <select id="selectXinProjectList" resultType="org.sys.rate.model.XinProject"
            parameterType="org.sys.rate.model.XinProjectVo">
        select
        *
        from xin_project
        <where>
            <if test="studentName!= null and studentName!= '' ">
                sname like concat('%', #{studentName}, '%')
            </if>
            <if test="name!= null and name!= '' ">
                and name = #{name}
            </if>
            <if test="state!= null and state!= '' ">
                and state = #{state}
            </if>
        </where>
        order by date DESC
    </select>

    <select id="selectById" resultType="org.sys.rate.model.XinProject" parameterType="java.lang.Integer">
        select * from xin_project where id = #{operatorId}
    </select>


    <!-- 删除操作：通过 mid 和 type 删除记录 -->
    <delete id="deleteXinProject" parameterType="org.sys.rate.model.XinProject">
        DELETE FROM xin_project
        WHERE mid = #{mid} AND type = #{type};
    </delete>
